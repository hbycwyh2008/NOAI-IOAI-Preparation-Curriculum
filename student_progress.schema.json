{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "student_progress.schema.json",
  "title": "NOAI/IOAI Student Progress Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "student_id",
    "pathway",
    "completed_sessions",
    "red_sessions",
    "qualified_pathways",
    "drill_history",
    "recognition_confirmation",
    "last_updated"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "student_id": {
      "type": "string",
      "minLength": 1,
      "description": "Use a pseudonymous identifier; do not store a name or email address."
    },
    "pathway": {
      "enum": ["noai_round1", "noai_round2", "ioai_full"]
    },
    "completed_sessions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1, "maximum": 78}
    },
    "red_sessions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1, "maximum": 78},
      "description": "Blocking prerequisite debt. Every Red Session must also appear in completed_sessions."
    },
    "qualified_pathways": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["noai_round1", "noai_round2", "ioai_full"]}
    },
    "drill_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "set_id",
          "level",
          "scenario_ids",
          "task_family_accuracy",
          "baseline_metric_accuracy",
          "score_percent",
          "reviewed"
        ],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "set_id": {"type": "string", "pattern": "^[0-9a-f]{10}$"},
          "level": {"enum": ["1", "2", "3", "mixed"]},
          "scenario_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^L[1-3]-D[0-9]{2}$"}
          },
          "task_family_accuracy": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "baseline_metric_accuracy": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "score_percent": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 100
          },
          "reviewed": {"type": "boolean"}
        }
      }
    },
    "recognition_confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "date"],
      "properties": {
        "passed": {"type": "boolean"},
        "date": {"type": ["string", "null"], "format": "date"}
      },
      "description": "Stores only whether and when a fresh private secured confirmation set passed; never store its protected content."
    },
    "last_updated": {"type": "string", "format": "date"}
  }
}
